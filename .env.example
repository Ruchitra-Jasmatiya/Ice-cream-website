# ───────── Required on Vercel (Project → Settings → Environment Variables) ─────────
ADMIN_PASSWORD=choose-a-strong-password        # login password for /admin
ADMIN_SECRET=put-a-long-random-string-here     # signs the admin session cookie (any long random text)

# ───────── Database (added automatically when you connect Upstash Redis in Vercel) ─────────
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...
# (older Vercel KV names also work: KV_REST_API_URL / KV_REST_API_TOKEN)

# ───────── Optional ─────────
# ADMIN_FORCE_ENV_PASSWORD=true   # forgot the password you set in the panel? set this once to log in with ADMIN_PASSWORD again
# ALLOWED_ORIGINS=https://your-other-site.com   # only if another website needs to call this API
